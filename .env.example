# Salin ke .env sebelum menjalankan stack:
#   cp .env.example .env
#   docker compose --env-file .env up -d
# .env tidak boleh di-commit.

# --- MinIO (raw zone + warehouse) ---
MINIO_ROOT_USER=dsic2906
MINIO_ROOT_PASSWORD=CHANGE_ME_MIN_8_CHARS
MINIO_BUCKET=dsic2906
MINIO_ENDPOINT=http://minio:9000

# --- Iceberg REST catalog ---
ICEBERG_WAREHOUSE=s3://dsic2906/warehouse
ICEBERG_CATALOG_URI=http://iceberg-rest:8181

# --- Trino ---
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=dsic2906
TRINO_CATALOG=iceberg

# --- Resource cap (dibekukan sebelum E3/E5, lihat configs/environment.yaml) ---
TRINO_CPUS=4
TRINO_MEMORY=8g
SPARK_CPUS=4
SPARK_MEMORY=8g
MINIO_CPUS=2
MINIO_MEMORY=4g

# --- Acquisition ---
# Identitas crawler wajib diisi: sopan santun dan syarat banyak situs berita.
CRAWLER_USER_AGENT=DSIC2906-research-crawler (mailto:ardika.satria@sd.itera.ac.id)
CRAWLER_DELAY_SECONDS=2
WIKIMEDIA_USER_AGENT=DSIC2906-research (mailto:ardika.satria@sd.itera.ac.id)

# --- Reproducibility ---
RANDOM_SEED=42
